<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.sonytvvibe.launcher" android:versionCode="18" android:versionName="0.5.0-template">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <queries>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent>
        <intent><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.HOME" /></intent>
        <package android:name="com.netflix.ninja" />
        <package android:name="com.google.android.youtube.tv" />
        <package android:name="in.startv.hotstar" />
        <package android:name="com.amazon.amazonvideo.livingroom" />
        <package android:name="com.plexapp.android" />
        <package android:name="org.videolan.vlc" />
        <package android:name="com.apple.atve.sony.appletv" />
        <package android:name="com.sonyliv" />
        <intent><action android:name="android.speech.action.WEB_SEARCH" /></intent>
    </queries>
    <application android:label="TV Vibe Preview" android:theme="@style/AppTheme" android:icon="@drawable/banner" android:banner="@drawable/banner" android:allowBackup="false" android:debuggable="true" android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
